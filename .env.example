POSTGRES_DB=fenx
POSTGRES_USER=fenx
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://fenx:change-me@postgres:5432/fenx?sslmode=disable
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-32-byte-random-secret
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me
BACKEND_ADDR=:8080
# 单容器部署（后端托管前端）时以下两项不需要配置：
# FRONTEND_ORIGIN 仅在前端部署到其他域名/端口、存在跨域时才需要设置
# VITE_API_BASE 是前端构建期变量，仅在前后端分离部署时指向浏览器可访问的后端地址；
# 切勿填 localhost（那会让每个访客的浏览器请求他自己的电脑）
DECISION_SHARED_SECRET=replace-with-shared-hmac-secret
FENX_DECISION_URL=http://127.0.0.1:8080/api/v1/decision
FENX_DECISION_SECRET=replace-with-shared-hmac-secret
